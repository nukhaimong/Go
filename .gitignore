# --- Go Binaries and Executables ---
# Compiles binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries compiled by 'go test'
*.test

# Output of the go coverage tool, generated by 'go test -coverprofile'
*.out

# Common custom binary names (add your app name here if different)
/bin/
/pkg/
main
server
app

# --- Dependency Management ---
# Keep go.sum, but ignore vendored dependencies if you don't explicitly want them
# vendor/

# --- Environment Variables & Secrets ---
# NEVER commit credentials to git
.env
.env.local
.env.*.local
*.pem
*.key

# --- IDEs and Text Editors ---
# JetBrains (GoLand, IntelliJ, etc.)
.idea/
*.iwb
*.iws

# Visual Studio Code
.vscode/
!.vscode/extensions.json

# macOS specific files
.DS_Store